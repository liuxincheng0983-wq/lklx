[Unit]
Description=两颗心 自建中转（LiangleXin Relay）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/liangkeixin-relay
# 改成你自己的口令；不想校验就删掉 Environment=RELAY_TOKEN 这一行
Environment=PORT=8890
Environment=HOST=127.0.0.1
Environment=RELAY_TOKEN=换成你自己的口令
ExecStart=/usr/bin/node /opt/liangkeixin-relay/server.js
Restart=always
RestartSec=3
User=www-data
Group=www-data
# 只监听本机 127.0.0.1 的话，前面必须挂 nginx/caddy 做 HTTPS 转发
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
